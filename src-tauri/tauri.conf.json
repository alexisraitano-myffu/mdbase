{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mdbase",
  "version": "../package.json",
  "identifier": "studio.myffu.mdbase",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:bureau"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "mdbase",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "publisher": "Alexis Raitano",
    "copyright": "MIT",
    "category": "Productivity",
    "shortDescription": "Bases de données dans un dossier de fichiers Markdown",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"]
      }
    }
  }
}
