{
  "name": "mdbase",
  "version": "1.2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.jira.config.ts && npm run mcp",
    "build:bureau": "tsc -b && vite build",
    "bureau": "tauri dev",
    "mcp": "vite build --config vite.mcp.config.ts && mcpb pack dist-mcp dist/mdbase.mcpb",
    "jira": "vite build --config vite.jira.config.ts && node dist/mdbase-jira.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "banc": "vitest run --config vitest.banc.config.ts"
  },
  "license": "MIT",
  "description": "Bases de données façon Notion, stockées dans un dossier de fichiers Markdown + YAML.",
  "homepage": "https://alexisraitano-myffu.github.io/mdbase/",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexisraitano-myffu/mdbase.git"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@dnd-kit/core": "^6.3.1",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.12.1",
    "fflate": "^0.8.3",
    "lucide": "^1.49.0",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.13.0",
    "minisearch": "^7.2.0",
    "modern-screenshot": "^4.7.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "private": true,
  "type": "module"
}
