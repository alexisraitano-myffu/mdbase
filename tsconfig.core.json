{
  // Le cœur : ni DOM, ni React, ni Node. Toute référence à window, document,
  // fetch ou process échoue à la compilation (spec §12).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.core.tsbuildinfo",
    "lib": ["ES2022"],
    "types": []
  },
  "include": ["src/core"],
  "exclude": ["src/**/*.test.ts"]
}
